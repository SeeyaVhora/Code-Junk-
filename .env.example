# ── API ─────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://codejunk:codejunk@localhost:5432/codejunk

# 32-byte secrets, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Encrypts users' own AI keys at rest (AES-256-GCM)
CREDENTIALS_ENCRYPTION_KEY=

# Server-side AI keys (never exposed to the browser; no VITE_ prefix!)
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Storage: "disk" (dev) or "s3"
STORAGE_DRIVER=disk
STORAGE_DISK_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (password reset) — leave empty in dev to log reset links to console
SMTP_URL=
MAIL_FROM="Code Junk <no-reply@example.com>"

# ── WEB (public, bundled into the browser — never put secrets here) ──
VITE_API_URL=http://localhost:4000
